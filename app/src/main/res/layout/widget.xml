<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_habit" android:contentDescription="@string/widget_title"/>
        <TextView android:id="@+id/habit_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/widget_title" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/total_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/month_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="@color/text_secondary" android:textSize="10sp"/>
    <LinearLayout android:id="@+id/dots_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="vertical"/>
</LinearLayout>
