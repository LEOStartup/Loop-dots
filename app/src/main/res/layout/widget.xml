<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/glass_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/habit_icon" android:layout_width="30dp" android:layout_height="32dp" android:gravity="center" android:textSize="23sp"/>
<TextView android:id="@+id/habit_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginStart="5dp"/>
<TextView android:id="@+id/total_count" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:textSize="11sp" android:textColor="#FFFFFF" android:paddingHorizontal="4dp"/>
<TextView android:id="@+id/check_today" android:layout_width="30dp" android:layout_height="32dp" android:gravity="center" android:text="✓" android:textSize="20sp" android:textColor="#FFFFFF" android:contentDescription="Marcar ou desmarcar hoje"/>
<TextView android:id="@+id/configure" android:layout_width="28dp" android:layout_height="32dp" android:gravity="center" android:text="⚙" android:textSize="18sp" android:textColor="#AAAAAA" android:contentDescription="Configurar widget"/>
</LinearLayout>
<TextView android:id="@+id/month_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#AAAAAA" android:textSize="10sp"/>
<LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
<ImageView android:id="@+id/grid_bitmap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:contentDescription="Histórico de conclusões; toque para abrir o calendário"/>
<TextView android:id="@+id/empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toque para escolher o hábito" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
</LinearLayout>
</FrameLayout>
