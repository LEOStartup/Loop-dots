        <receiver android:name=".LoopDotsWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.leostartup.loopdots.TOGGLE_DAY"/>
